# Telegram
TELEGRAM_BOT_TOKEN=replace-with-new-token
WEBHOOK_URL=https://formpilot.onrender.com

# LLM (OpenRouter)
OPENROUTER_API_KEY=replace-with-new-key
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Proxy (optional; use only for authorized test traffic)
PROXY_GATEWAY=

# Form selectors
FORM_SELECTOR=div[role="radio"]
SUBMIT_SELECTOR=div[role="button"]
SUCCESS_SELECTOR=
SUCCESS_TEXT=Your response has been recorded

# Job limits
MAX_CONCURRENT_JOBS=1
MAX_RETRIES_PER_SUBMISSION=3
SUBMISSION_TIMEOUT_SEC=90

# Browser
HEADLESS=true
CHROME_BIN=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver
